export module pbsd.sys.security.mac.veriexec.b0029s2;

/*
 * The sole source file of batch b0029s2, mac_veriexec_sha256.c, defines no
 * functions: its whole body is the kernel-only MAC_VERIEXEC_FPMOD()
 * registration macro.  That macro's struct layout and expansion live in
 * <security/mac_veriexec/mac_veriexec.h>, which is not part of this batch,
 * so the file is recorded in skipped.txt rather than ported.  Nothing was
 * faithfully portable, so this namespace exports nothing.
 */
export namespace pbsd::sys_security_mac_veriexec::b0029s2 {
}
