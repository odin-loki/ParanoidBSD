std::size_t
GBK_wcsnrtombs(char * __restrict dst, const wchar_t ** __restrict src,
    std::size_t nwc, std::size_t len, mbstate_t * __restrict ps)
{
	return (_GBK_wcsnrtombs(dst, src, nwc, len, ps));
}

static std::size_t	_ascii_mbrtowc(wchar_t * __restrict, const char * __restrict,
		    std::size_t, mbstate_t * __restrict);
static int	_ascii_mbsinit(const mbstate_t *);
static std::size_t	_ascii_mbsnrtowcs(wchar_t * __restrict dst,
		    const char ** __restrict src, std::size_t nms, std::size_t len,
		    mbstate_t * __restrict ps);
static std::size_t	_ascii_wcrtomb(char * __restrict, wchar_t,
		    mbstate_t * __restrict);
static std::size_t	_ascii_wcsnrtombs(char * __restrict, const wchar_t ** __restrict,
		    std::size_t, std::size_t, mbstate_t * __restrict);

int
ascii_init(struct xlocale_ctype *l,_RuneLocale *rl)
{

	l->__mbrtowc = _ascii_mbrtowc;
	l->__mbsinit = _ascii_mbsinit;
	l->__mbsnrtowcs = _ascii_mbsnrtowcs;
	l->__wcrtomb = _ascii_wcrtomb;
	l->__wcsnrtombs = _ascii_wcsnrtombs;
	l->runes = rl;
	l->__mb_cur_max = 1;
	l->__mb_sb_limit = 128;
	return(0);
}

static int
_ascii_mbsinit(const mbstate_t *ps)
{

	/*
	 * Encoding is not state dependent - we are always in the
	 * initial state.
	 */
	(void)ps;
	return (1);
}

int
ascii_mbsinit(const mbstate_t *ps)
{
	return (_ascii_mbsinit(ps));
}

static std::size_t
_ascii_mbrtowc(wchar_t * __restrict pwc, const char * __restrict s, std::size_t n,
    mbstate_t * __restrict ps)
{

	(void)ps;
	if (s == NULL)
		/* Reset to initial shift state (no-op) */
		return (0);
	if (n == 0)
		/* Incomplete multibyte sequence */
		return ((std::size_t)-2);
	if (*s & 0x80) {
		errno = EILSEQ;
		return ((std::size_t)-1);
	}
	if (pwc != NULL)
		*pwc = (unsigned char)*s;
	return (*s == '\0' ? 0 : 1);
}

std::size_t
ascii_mbrtowc(wchar_t * __restrict pwc, const char * __restrict s, std::size_t n,
    mbstate_t * __restrict ps)
{
	return (_ascii_mbrtowc(pwc, s, n, ps));
}

static std::size_t
_ascii_wcrtomb(char * __restrict s, wchar_t wc,
    mbstate_t * __restrict ps)
{

	(void)ps;
	if (s == NULL)
		/* Reset to initial shift state (no-op) */
		return (1);
	if (wc < 0 || wc > 127) {
		errno = EILSEQ;
		return ((std::size_t)-1);
	}
	*s = (unsigned char)wc;
	return (1);
}

std::size_t
ascii_wcrtomb(char * __restrict s, wchar_t wc,
    mbstate_t * __restrict ps)
{
	return (_ascii_wcrtomb(s, wc, ps));
}

static std::size_t
_ascii_mbsnrtowcs(wchar_t * __restrict dst, const char ** __restrict src,
    std::size_t nms, std::size_t len, mbstate_t * __restrict ps)
{
	const char *s;
	std::size_t nchr;

	(void)ps;
	if (dst == NULL) {
		for (s = *src; nms > 0 && *s != '\0'; s++, nms--) {
			if (*s & 0x80) {
				errno = EILSEQ;
				return ((std::size_t)-1);
			}
		}
		return (s - *src);
	}

	s = *src;
	nchr = 0;
	while (len-- > 0 && nms-- > 0) {
		if (*s & 0x80) {
			*src = s;
			errno = EILSEQ;
			return ((std::size_t)-1);
		}
		if ((*dst++ = (unsigned char)*s++) == L'\0') {
			*src = NULL;
			return (nchr);
		}
		nchr++;
	}
	*src = s;
	return (nchr);
}

std::size_t
ascii_mbsnrtowcs(wchar_t * __restrict dst, const char ** __restrict src,
    std::size_t nms, std::size_t len, mbstate_t * __restrict ps)
{
	return (_ascii_mbsnrtowcs(dst, src, nms, len, ps));
}

static std::size_t
_ascii_wcsnrtombs(char * __restrict dst, const wchar_t ** __restrict src,
    std::size_t nwc, std::size_t len, mbstate_t * __restrict ps)
{
	const wchar_t *s;
	std::size_t nchr;

	(void)ps;
	if (dst == NULL) {
		for (s = *src; nwc > 0 && *s != L'\0'; s++, nwc--) {
			if (*s < 0 || *s > 127) {
				errno = EILSEQ;
				return ((std::size_t)-1);
			}
		}
		return (s - *src);
	}

	s = *src;
	nchr = 0;
	while (len-- > 0 && nwc-- > 0) {
		if (*s < 0 || *s > 127) {
			*src = s;
			errno = EILSEQ;
			return ((std::size_t)-1);
		}
		if ((*dst++ = *s++) == '\0') {
			*src = NULL;
			return (nchr);
		}
		nchr++;
	}
	*src = s;
	return (nchr);
}

std::size_t
ascii_wcsnrtombs(char * __restrict dst, const wchar_t ** __restrict src,
    std::size_t nwc, std::size_t len, mbstate_t * __restrict ps)
{
	return (_ascii_wcsnrtombs(dst, src, nwc, len, ps));
}

typedef struct {
	wchar_t	ch;
} _MSKanjiState;

static std::size_t	_MSKanji_mbrtowc(wchar_t * __restrict, const char * __restrict,
		    std::size_t, mbstate_t * __restrict);
static int	_MSKanji_mbsinit(const mbstate_t *);
static std::size_t	_MSKanji_wcrtomb(char * __restrict, wchar_t,
		    mbstate_t * __restrict);
static std::size_t	_MSKanji_mbsnrtowcs(wchar_t * __restrict,
		    const char ** __restrict, std::size_t, std::size_t,
		    mbstate_t * __restrict);
static std::size_t	_MSKanji_wcsnrtombs(char * __restrict,
		    const wchar_t ** __restrict, std::size_t, std::size_t,
		    mbstate_t * __restrict);

int
MSKanji_init(struct xlocale_ctype *l, _RuneLocale *rl)
{

	l->__mbrtowc = _MSKanji_mbrtowc;
	l->__wcrtomb = _MSKanji_wcrtomb;
	l->__mbsnrtowcs = _MSKanji_mbsnrtowcs;
	l->__wcsnrtombs = _MSKanji_wcsnrtombs;
	l->__mbsinit = _MSKanji_mbsinit;
	l->runes = rl;
	l->__mb_cur_max = 2;
	l->__mb_sb_limit = 224;
	return (0);
}

static int
_MSKanji_mbsinit(const mbstate_t *ps)
{

	return (ps == NULL || ((const _MSKanjiState *)ps)->ch == 0);
}

int
MSKanji_mbsinit(const mbstate_t *ps)
{
	return (_MSKanji_mbsinit(ps));
}

static std::size_t
_MSKanji_mbrtowc(wchar_t * __restrict pwc, const char * __restrict s, std::size_t n,
    mbstate_t * __restrict ps)
{
	_MSKanjiState *ms;
	wchar_t wc;

	ms = (_MSKanjiState *)ps;

	if ((ms->ch & ~0xFF) != 0) {
		/* Bad conversion state. */
		errno = EINVAL;
		return ((std::size_t)-1);
	}

	if (s == NULL) {
		s = "";
		n = 1;
		pwc = NULL;
	}

	if (n == 0)
		/* Incomplete multibyte sequence */
		return ((std::size_t)-2);

	if (ms->ch != 0) {
		if (*s == '\0') {
			errno = EILSEQ;
			return ((std::size_t)-1);
		}
		wc = (ms->ch << 8) | (*s & 0xFF);
		if (pwc != NULL)
			*pwc = wc;
		ms->ch = 0;
		return (1);
	}
	wc = *s++ & 0xff;
	if ((wc > 0x80 && wc < 0xa0) || (wc >= 0xe0 && wc < 0xfd)) {
		if (n < 2) {
			/* Incomplete multibyte sequence */
			ms->ch = wc;
			return ((std::size_t)-2);
		}
		if (*s == '\0') {
			errno = EILSEQ;
			return ((std::size_t)-1);
		}
		wc = (wc << 8) | (*s++ & 0xff);
		if (pwc != NULL)
			*pwc = wc;
		return (2);
	} else {
		if (pwc != NULL)
			*pwc = wc;
		return (wc == L'\0' ? 0 : 1);
	}
}

std::size_t
MSKanji_mbrtowc(wchar_t * __restrict pwc, const char * __restrict s, std::size_t n,
    mbstate_t * __restrict ps)
{
	return (_MSKanji_mbrtowc(pwc, s, n, ps));
}

static std::size_t
_MSKanji_wcrtomb(char * __restrict s, wchar_t wc, mbstate_t * __restrict ps)
{
	_MSKanjiState *ms;
	int len, i;

	ms = (_MSKanjiState *)ps;

	if (ms->ch != 0) {
		errno = EINVAL;
		return ((std::size_t)-1);
	}

	if (s == NULL)
		/* Reset to initial shift state (no-op) */
		return (1);
	len = (wc > 0x100) ? 2 : 1;
	for (i = len; i-- > 0; )
		*s++ = wc >> (i << 3);
	return (len);
}

std::size_t
MSKanji_wcrtomb(char * __restrict s, wchar_t wc, mbstate_t * __restrict ps)
{
	return (_MSKanji_wcrtomb(s, wc, ps));
}

static std::size_t
_MSKanji_mbsnrtowcs(wchar_t * __restrict dst, const char ** __restrict src,
    std::size_t nms, std::size_t len, mbstate_t * __restrict ps)
{
	return (__mbsnrtowcs_std(dst, src, nms, len, ps, _MSKanji_mbrtowc));
}

std::size_t
MSKanji_mbsnrtowcs(wchar_t * __restrict dst, const char ** __restrict src,
    std::size_t nms, std::size_t len, mbstate_t * __restrict ps)
{
	return (_MSKanji_mbsnrtowcs(dst, src, nms, len, ps));
}

static std::size_t
_MSKanji_wcsnrtombs(char * __restrict dst, const wchar_t ** __restrict src,
    std::size_t nwc, std::size_t len, mbstate_t * __restrict ps)
{
	return (__wcsnrtombs_std(dst, src, nwc, len, ps, _MSKanji_wcrtomb));
}

std::size_t
MSKanji_wcsnrtombs(char * __restrict dst, const wchar_t ** __restrict src,
    std::size_t nwc, std::size_t len, mbstate_t * __restrict ps)
{
	return (_MSKanji_wcsnrtombs(dst, src, nwc, len, ps));
}

