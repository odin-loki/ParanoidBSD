bool
cap_sandboxed(void)
{
	u_int mode;

	if (cap_getmode(&mode) != 0) {
		assert(errno == ENOSYS);
		return (false);
	}
	assert(mode == 0 || mode == 1);
	return (mode == 1);
}

} /* namespace pbsd::lib_libc_gen::b0247 */
