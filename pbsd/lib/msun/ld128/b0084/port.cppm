module;

#include <cstring>

export module pbsd.lib.msun.ld128.b0084;

export namespace pbsd::lib_msun_ld128::b0084 {

namespace detail {

inline long double
ld_from_bytes(const unsigned char (&b)[16])
{
	long double r = 0;

	std::memcpy(&r, b, sizeof(r));
	return r;
}

} // namespace detail

/*
 * asinl() and acosl()
 *
 * Decimal literals from invtrig.c are stored via the host C compiler's
 * x87 rounding (byte patterns taken from oracle.c).
 */
