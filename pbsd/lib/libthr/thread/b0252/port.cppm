pthread_t
_Tthr_self(void)
{
	_thr_check_init();

	/* Return the running thread pointer: */
	return (_get_curthread());
}

static int
_pthread_equal(pthread_t t1, pthread_t t2)
{
	return (_thr_equal(t1, t2));
}

static pthread_t
_pthread_self(void)
{
	return (_Tthr_self());
}

