/*
 * port.cppm -- PBSD batch b0230.
 *
 * A C++23 module port of the HardenedBSD bin/sh sources listed below.  The
 * translation is deliberately literal: control flow, integer signedness,
 * evaluation order and pointer arithmetic are preserved exactly, including
 * the places where the original is dubious.  Nothing here is "improved".
 *
 * Sources:
 *   hbsd/src/bin/sh/cd.c
 *   hbsd/src/bin/sh/mknodes.c
 *   hbsd/src/bin/sh/trap.c
 *   hbsd/src/bin/sh/input.c
 *
 * Functions from those files that could not be carried over without dragging
 * in the rest of the shell are listed, with reasons, in skipped.txt.
 */

module;

#include <sys/types.h>
#include <sys/stat.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <unistd.h>
#include <errno.h>
#include <limits.h>
#include <signal.h>
#include <stdarg.h>

#ifndef LONG_BIT
#define LONG_BIT	(sizeof(long) * 8)
#endif
#ifndef NSIG
#define NSIG		65
#endif

export module pbsd.bin.sh.b0230;

extern "C" int is_number(const char *);
extern "C" const char **sys_signame;
extern "C" int sys_nsig;
extern "C" void out1str(const char *);
extern "C" void out1c(int);
extern "C" void out1fmt(const char *, ...);

#define MAXTYPES 50		/* max number of node types */
#define MAXFIELDS 20		/* max fields in a structure */
#define BUFLEN 100		/* size of character buffers */

/* field types */
#define T_NODE 1		/* union node *field */
#define T_NODELIST 2		/* struct nodelist *field */
#define T_STRING 3
#define T_INT 4			/* int field */
#define T_OTHER 5		/* other */
#define T_TEMP 6		/* don't copy this field */

#define EOF_NLEFT -99		/* value of parsenleft when EOF pushed back */

namespace pbsd::bin_sh::b0230 {

static const char writer[] = "\
/*\n\
 * This file was generated by the mknodes program.\n\
 */\n\
\n";

}

export namespace pbsd::bin_sh::b0230 {

inline constexpr int port_nsig_value = NSIG;

