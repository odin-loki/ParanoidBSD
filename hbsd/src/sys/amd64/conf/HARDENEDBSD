#
# HARDENEDBSD -- Main HardenedBSD kernel configuration for amd64.
#
# The hardening policy is sys/conf/std.hardenedbsd and is the same on every
# architecture. Anything below the include is an overload for amd64
# specifically, and has to justify itself as such.

include GENERIC
include "std.hardenedbsd"

ident		HARDENEDBSD

# amd64 is the reference platform and carries the assertion build.
include "std.hardenedbsd.debug"
include "std.debug"
