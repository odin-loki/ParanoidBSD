#
# HARDENEDBSD -- Main HardenedBSD kernel configuration for arm64.
#
# The hardening policy is sys/conf/std.hardenedbsd and is the same on every
# architecture. Anything below the include is an overload for arm64
# specifically, and has to justify itself as such.

include GENERIC
include "std.hardenedbsd"

ident		HARDENEDBSD

# Needed for ThunderX2 systems.
options 	NUMA
