# Copy this file to api-keys (no extension) or api-keys.env and fill in values.
#   copy secrets\api-keys.example secrets\api-keys
# pbsd.py, the WSL driver/watchdog, and tools/pbsd_agent_port.py load that file
# automatically. Real key files in this folder are gitignored. Never commit them.

# DeepSeek (Flash / Pro) — tools/pbsd_agent_port.py
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_REASONING_EFFORT=max

# Cursor agent (pbsd.py / WSL driver) — prefer env or cursor-agent login
CURSOR_API_KEY=
