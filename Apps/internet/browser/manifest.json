{
  "id": "org.pbsd.browser",
  "name": "Web Browser",
  "version": "0.1.0",
  "category": "internet",
  "entry": "main.fs",
  "single_instance": false,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "fs.path:/etc/pbsd/browser/policies:r",
    "net.user",
    "net.route:clear",
    "net.route:vpn",
    "net.route:tor",
    "proc.helper:engine-supervisor",
    "proc.helper:content",
    "proc.helper:network",
    "proc.helper:decode-image",
    "proc.helper:decode-font",
    "proc.helper:media",
    "proc.helper:reader-archive",
    "proc.helper:sync",
    "dev.camera",
    "dev.mic",
    "dev.screen",
    "dev.location",
    "dev.print",
    "svc.settings",
    "svc.notify",
    "svc.portal.file",
    "svc.portal.print",
    "svc.portal.camera",
    "svc.portal.mic",
    "svc.portal.screen",
    "svc.portal.location",
    "svc.intent",
    "svc.search",
    "svc.keyring",
    "svc.clipboard",
    "svc.media",
    "svc.power",
    "svc.model",
    "svc.update",
    "svc.backup",
    "svc.audit",
    "svc.a11y",
    "ai.local",
    "bg.run"
  ],
  "helpers": [
    {"name": "engine-supervisor", "language": "c++23", "capabilities": ["proc.helper:content", "proc.helper:network", "proc.helper:decode-image", "proc.helper:decode-font", "proc.helper:media"]},
    {"name": "content", "language": "imported engine (C/C++, exception pending, SPEC 6.5)", "capabilities": []},
    {"name": "network", "language": "c++23", "capabilities": ["net.user", "net.route:clear|vpn|tor (exactly one per instance)"]},
    {"name": "decode-image", "language": "c++23", "capabilities": []},
    {"name": "decode-font", "language": "c++23", "capabilities": []},
    {"name": "media", "language": "c++23", "capabilities": []},
    {"name": "reader-archive", "language": "c++23", "capabilities": []},
    {"name": "sync", "language": "c++23", "capabilities": ["net.user"]}
  ],
  "mime": {
    "view": ["text/html", "application/xhtml+xml", "image/svg+xml", "application/x-pbsd-pagearc"],
    "edit": [],
    "import": ["text/x-netscape-bookmarks+html", "application/json", "multipart/related"],
    "export": ["application/pdf", "image/png", "application/warc", "application/x-pbsd-pagearc", "text/x-netscape-bookmarks+html", "application/json"]
  },
  "intents": {
    "handles": ["open", "view", "search"],
    "emits": ["open", "share", "print", "compose", "pick"]
  },
  "url_schemes": ["http", "https", "about"],
  "services_provided": [],
  "background": {"autostart": false, "run": false},
  "depends_on": ["org.pbsd.platform >= 0.1", "org.pbsd.portals >= 0.1", "org.pbsd.passwords >= 0.1"],
  "backing_repos": ["FUSE", "FORGE", "ANONYMOUS"],
  "priority": "P1"
}
