{
  "id": "org.pbsd.on-screen-keyboard",
  "name": "On-Screen Keyboard",
  "version": "0.1.0",
  "category": "access",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "net.none",
    "proc.helper:swipe-helper",
    "svc.a11y",
    "svc.a11y:input.synth",
    "svc.a11y:track",
    "svc.a11y:overlay",
    "svc.a11y:switch",
    "svc.a11y:tree.read",
    "svc.a11y:act",
    "svc.settings",
    "svc.notify",
    "svc.media",
    "svc.model",
    "svc.portal.file",
    "svc.input-method",
    "ai.local",
    "bg.run",
    "bg.autostart"
  ],
  "helpers": [{"name": "swipe-helper", "language": "c++23", "capabilities": []}],
  "mime": {"view": [], "edit": [], "import": ["application/json"], "export": ["application/json"]},
  "intents": {"handles": [], "emits": ["view", "open"]},
  "url_schemes": [],
  "services_provided": ["osk.show", "osk.hide", "osk.state"],
  "background": {"autostart": true, "run": true},
  "depends_on": ["org.pbsd.platform >= 0.1", "org.pbsd.input-methods >= 0.1"],
  "backing_repos": ["odin-loki/FUSE", "odin-loki/FORGE"],
  "priority": "P2"
}
