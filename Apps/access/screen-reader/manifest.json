{
  "id": "org.pbsd.screen-reader",
  "name": "Screen Reader",
  "version": "0.1.0",
  "category": "access",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "net.none",
    "proc.helper:speech-helper",
    "proc.helper:braille-helper",
    "svc.a11y",
    "svc.a11y:tree.read",
    "svc.a11y:text.read",
    "svc.a11y:events",
    "svc.a11y:act",
    "svc.a11y:keys.reader",
    "svc.a11y:overlay",
    "svc.a11y:secure.read",
    "svc.settings",
    "svc.notify",
    "svc.media",
    "svc.audit",
    "svc.power",
    "svc.clipboard",
    "svc.model",
    "svc.portal.file",
    "svc.portal.screen",
    "svc.portal.usb",
    "ai.local",
    "dev.screen",
    "dev.usb:hid-braille",
    "bg.run",
    "bg.autostart"
  ],
  "helpers": [
    {"name": "speech-helper", "language": "c++23", "capabilities": ["svc.media"]},
    {"name": "braille-helper", "language": "c++23", "capabilities": ["dev.usb:hid-braille"]}
  ],
  "mime": {"view": [], "edit": [], "import": ["application/json"], "export": ["application/json", "text/plain"]},
  "intents": {"handles": [], "emits": ["open", "view"]},
  "url_schemes": [],
  "services_provided": ["speech.say", "reader.status"],
  "background": {"autostart": true, "run": true},
  "depends_on": ["org.pbsd.platform >= 0.1"],
  "backing_repos": ["odin-loki/FUSE", "odin-loki/FORGE"],
  "priority": "P1"
}
