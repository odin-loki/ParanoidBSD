{
  "id": "org.pbsd.voice",
  "name": "Voice",
  "version": "0.1.0",
  "category": "access",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "net.none",
    "proc.helper:audio-front-helper",
    "dev.mic",
    "dev.gpu.compute",
    "svc.portal.mic",
    "svc.portal.file",
    "svc.media",
    "svc.model",
    "ai.local",
    "svc.a11y",
    "svc.a11y:tree.read",
    "svc.a11y:text.read",
    "svc.a11y:events",
    "svc.a11y:act",
    "svc.a11y:input.synth",
    "svc.a11y:overlay",
    "svc.input-method",
    "svc.clipboard",
    "svc.intent",
    "svc.settings",
    "svc.notify",
    "svc.audit",
    "bg.run",
    "bg.autostart"
  ],
  "helpers": [{"name": "audio-front-helper", "language": "c++23", "capabilities": ["dev.mic", "svc.media", "svc.model"]}],
  "mime": {"view": [], "edit": [], "import": ["application/json"], "export": ["application/json"]},
  "intents": {"handles": [], "emits": ["open", "search", "compose", "view"]},
  "url_schemes": [],
  "services_provided": ["voice.state", "voice.set_mode", "voice.commands"],
  "background": {"autostart": false, "run": true},
  "depends_on": ["org.pbsd.platform >= 0.1", "org.pbsd.input-methods >= 0.1"],
  "backing_repos": ["odin-loki/FORGE", "odin-loki/FUSE"],
  "priority": "P3"
}
