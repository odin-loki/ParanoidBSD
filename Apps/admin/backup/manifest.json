{
  "id": "org.pbsd.backup",
  "name": "Backup",
  "version": "0.1.0",
  "category": "admin",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "net.none",
    "svc.backup",
    "svc.storage",
    "svc.keyring",
    "svc.notify",
    "svc.settings",
    "svc.power",
    "svc.audit",
    "svc.thumbnail",
    "svc.search",
    "svc.portal.file",
    "svc.portal.print",
    "dev.print",
    "dev.usb:storage",
    "ai.local",
    "svc.model"
  ],
  "helpers": [],
  "mime": {
    "view": ["application/vnd.pbsd.backup-plan+json"],
    "edit": ["application/vnd.pbsd.backup-plan+json"],
    "import": ["application/vnd.pbsd.backup-plan+json"],
    "export": ["application/vnd.pbsd.backup-plan+json", "application/pdf", "text/plain", "text/markdown", "application/json"]
  },
  "intents": {"handles": ["open", "view", "search"], "emits": ["open", "print", "share"]},
  "url_schemes": ["pbsd-backup"],
  "services_provided": [],
  "background": {"autostart": false, "run": false},
  "depends_on": ["org.pbsd.platform >= 0.1", "org.pbsd.passwords >= 0.1"],
  "backing_repos": ["ParanoidBSD", "FUSE", "FORGE"],
  "priority": "P1"
}
