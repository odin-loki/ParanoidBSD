{
  "id": "org.pbsd.logs",
  "name": "Logs",
  "version": "0.1.0",
  "category": "admin",
  "entry": "main.fs",
  "single_instance": false,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "net.none",
    "svc.logs",
    "svc.audit",
    "svc.settings",
    "svc.notify",
    "svc.keyring",
    "svc.portal.file",
    "svc.portal.print",
    "dev.print",
    "proc.helper:decode-helper",
    "proc.helper:symbol-helper",
    "ai.local",
    "svc.model"
  ],
  "helpers": [
    {"name": "decode-helper", "language": "c++23", "capabilities": []},
    {"name": "symbol-helper", "language": "c++23", "capabilities": []}
  ],
  "mime": {
    "view": ["text/x-log", "application/vnd.pbsd.log-bundle", "application/x-bsm-audit", "application/x-ndjson"],
    "edit": [],
    "import": ["text/x-log", "application/vnd.pbsd.log-bundle", "application/x-bsm-audit", "application/gzip", "application/zstd", "application/x-xz"],
    "export": ["text/plain", "application/x-ndjson", "text/csv", "text/markdown", "application/vnd.pbsd.log-bundle"]
  },
  "intents": {"handles": ["open", "view", "search"], "emits": ["open", "share", "print"]},
  "url_schemes": ["pbsd-logs"],
  "services_provided": [],
  "background": {"autostart": false, "run": false},
  "depends_on": ["org.pbsd.platform >= 0.1"],
  "backing_repos": ["ParanoidBSD", "FORGE", "FUSE"],
  "priority": "P1"
}
