{
  "id": "org.pbsd.disks",
  "name": "Disks",
  "version": "0.1.0",
  "category": "admin",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "net.none",
    "svc.storage",
    "svc.notify",
    "svc.settings",
    "svc.keyring",
    "svc.audit",
    "svc.power",
    "svc.portal.file",
    "svc.portal.usb",
    "dev.usb:storage",
    "proc.helper:image-helper",
    "ai.local",
    "svc.model"
  ],
  "helpers": [
    {
      "name": "image-helper",
      "language": "c++23",
      "capabilities": []
    }
  ],
  "mime": {
    "view": [
      "application/x-iso9660-image",
      "application/x-raw-disk-image"
    ],
    "edit": [],
    "import": [
      "application/x-iso9660-image",
      "application/x-raw-disk-image",
      "application/zstd",
      "application/x-xz",
      "application/gzip"
    ],
    "export": [
      "application/x-raw-disk-image",
      "application/zstd",
      "text/markdown",
      "application/json",
      "application/pdf",
      "image/svg+xml",
      "image/png"
    ]
  },
  "intents": {
    "handles": [
      "open",
      "view"
    ],
    "emits": [
      "open",
      "share",
      "print"
    ]
  },
  "url_schemes": [
    "pbsd-storage"
  ],
  "services_provided": [],
  "background": {
    "autostart": false,
    "run": false
  },
  "depends_on": [
    "org.pbsd.platform >= 0.1"
  ],
  "backing_repos": [
    "ParanoidBSD",
    "FUSE",
    "FORGE"
  ],
  "priority": "P1"
}
