{
  "id": "org.pbsd.terminal",
  "name": "Terminal",
  "version": "0.1.0",
  "category": "system",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "fs.path:~:rw",
    "fs.path:/:r",
    "proc.exec",
    "proc.helper:session-keeper",
    "proc.helper:shell-launcher",
    "proc.helper:image-decoder",
    "proc.helper:config-reader",
    "net.user",
    "net.route:clear",
    "net.route:vpn",
    "net.route:tor",
    "dev.usb:serial",
    "dev.gpu.compute",
    "bg.run",
    "ai.local",
    "svc.settings",
    "svc.notify",
    "svc.intent",
    "svc.portal.file",
    "svc.portal.print",
    "svc.clipboard",
    "svc.keyring",
    "svc.audit",
    "svc.power",
    "svc.model",
    "svc.a11y"
  ],
  "helpers": [
    {"name": "session-keeper", "language": "c++23", "capabilities": ["bg.run"]},
    {"name": "shell-launcher", "language": "c++23", "capabilities": ["proc.exec"]},
    {"name": "image-decoder", "language": "c++23", "capabilities": []},
    {"name": "config-reader", "language": "c++23", "capabilities": []}
  ],
  "mime": {
    "view": ["application/x-asciicast"],
    "edit": [],
    "import": ["application/x-pbsd-terminal-profile+json", "application/x-iterm-colors", "application/yaml"],
    "export": ["text/plain", "text/html", "application/x-asciicast", "application/x-pbsd-terminal-profile+json"]
  },
  "intents": {"handles": ["open", "view"], "emits": ["open", "share", "print"]},
  "url_schemes": ["ssh"],
  "services_provided": ["org.pbsd.terminal.control", "org.pbsd.terminal.sessions"],
  "background": {"autostart": false, "run": true},
  "depends_on": ["org.pbsd.platform >= 0.1"],
  "backing_repos": ["FUSE", "FORGE"],
  "priority": "P0"
}
