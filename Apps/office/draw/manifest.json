{
  "id": "org.pbsd.draw",
  "name": "Draw",
  "version": "0.1.0",
  "category": "office",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "net.none",
    "proc.helper:vector-core",
    "proc.helper:draw-io",
    "proc.helper:macro-host",
    "dev.print",
    "svc.settings",
    "svc.notify",
    "svc.portal.file",
    "svc.portal.print",
    "svc.intent",
    "svc.search",
    "svc.clipboard",
    "svc.thumbnail",
    "svc.keyring",
    "svc.audit",
    "svc.a11y",
    "svc.backup"
  ],
  "optional_capabilities": [
    {"capability": "dev.gpu.compute", "default": "off", "reason": "Canvas on the Vulkan backend"},
    {"capability": "ai.local", "default": "off", "reason": "Draft diagram text from a description"},
    {"capability": "svc.model", "default": "off", "reason": "Draft diagram text from a description"}
  ],
  "helpers": [
    {"name": "vector-core", "language": "c++23", "capabilities": []},
    {"name": "draw-io", "language": "c++23", "capabilities": []},
    {"name": "macro-host", "language": "c++23", "capabilities": []}
  ],
  "mime": {
    "view": [
      "application/vnd.oasis.opendocument.graphics",
      "application/vnd.oasis.opendocument.graphics-template",
      "application/vnd.oasis.opendocument.graphics-flat-xml",
      "image/svg+xml"
    ],
    "edit": [
      "application/vnd.oasis.opendocument.graphics",
      "application/vnd.oasis.opendocument.graphics-template",
      "application/vnd.oasis.opendocument.graphics-flat-xml",
      "image/svg+xml"
    ],
    "import": [
      "application/vnd.jgraph.mxfile",
      "application/vnd.ms-visio.drawing.main+xml",
      "application/vnd.ms-visio.stencil.main+xml",
      "application/vnd.ms-visio.template.main+xml",
      "text/vnd.mermaid",
      "text/vnd.graphviz",
      "image/png",
      "image/jpeg",
      "image/webp"
    ],
    "export": [
      "image/svg+xml",
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/webp",
      "application/vnd.jgraph.mxfile"
    ]
  },
  "intents": {"handles": ["open", "edit", "view", "new", "print"], "emits": ["share", "print", "edit", "open"]},
  "url_schemes": [],
  "services_provided": ["org.pbsd.draw.render/1"],
  "background": {"autostart": false, "run": false},
  "depends_on": ["org.pbsd.platform >= 0.1"],
  "backing_repos": ["FUSE", "FORGE"],
  "priority": "P2"
}
