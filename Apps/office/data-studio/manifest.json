{
  "id": "org.pbsd.data-studio",
  "name": "Data Studio",
  "version": "0.1.0",
  "category": "office",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app",
    "fs.portal",
    "net.none",
    "proc.helper:sql-lang",
    "proc.helper:sqlite-worker",
    "proc.helper:db-net",
    "proc.helper:file-engine",
    "proc.helper:macro-host",
    "dev.print",
    "svc.settings",
    "svc.notify",
    "svc.portal.file",
    "svc.portal.print",
    "svc.intent",
    "svc.search",
    "svc.keyring",
    "svc.clipboard",
    "svc.audit",
    "svc.a11y",
    "svc.backup",
    "svc.power"
  ],
  "optional_capabilities": [
    {"capability": "net.host:<user-added host>:<port>", "default": "off", "reason": "One grant per server connection the user adds, requested at run time through the shell prompt and used only by the db-net helper. Needs the platform change described as OF09-GAP-2"},
    {"capability": "net.route:vpn", "default": "off", "reason": "Bind a connection to the VPN route"},
    {"capability": "net.route:tor", "default": "off", "reason": "Bind a connection to the anonymous route"},
    {"capability": "ai.local", "default": "off", "reason": "Explain and draft SQL"},
    {"capability": "svc.model", "default": "off", "reason": "Explain and draft SQL"}
  ],
  "helpers": [
    {"name": "sql-lang", "language": "c++23", "capabilities": []},
    {"name": "sqlite-worker", "language": "c++23", "capabilities": []},
    {"name": "db-net", "language": "c++23", "capabilities": ["net.host:<user-added host>:<port>"]},
    {"name": "file-engine", "language": "c++23", "capabilities": []},
    {"name": "macro-host", "language": "c++23", "capabilities": []}
  ],
  "mime": {
    "view": [
      "application/vnd.sqlite3",
      "application/sql",
      "application/vnd.apache.parquet",
      "text/csv",
      "text/tab-separated-values",
      "application/json",
      "application/x-ndjson"
    ],
    "edit": ["application/vnd.sqlite3", "application/sql"],
    "import": [
      "text/csv",
      "text/tab-separated-values",
      "application/json",
      "application/x-ndjson",
      "application/vnd.apache.parquet"
    ],
    "export": [
      "text/csv",
      "text/tab-separated-values",
      "application/json",
      "application/x-ndjson",
      "application/vnd.apache.parquet",
      "application/sql",
      "application/vnd.sqlite3",
      "application/vnd.oasis.opendocument.spreadsheet",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "text/markdown",
      "text/html",
      "image/svg+xml",
      "image/png",
      "application/pdf"
    ]
  },
  "intents": {"handles": ["open", "view", "new"], "emits": ["share", "print", "open", "edit"]},
  "url_schemes": [],
  "services_provided": [],
  "background": {"autostart": false, "run": false},
  "depends_on": ["org.pbsd.platform >= 0.1"],
  "backing_repos": ["FUSE", "FORGE"],
  "priority": "P2"
}
