{
  "id": "org.pbsd.contacts",
  "name": "Contacts",
  "version": "0.1.0",
  "category": "comms",
  "entry": "main.fs",
  "single_instance": true,
  "capabilities": [
    "fs.app", "fs.portal",
    "net.user", "net.route:clear", "net.route:vpn", "net.route:tor",
    "proc.helper:vcard", "proc.helper:dav", "proc.helper:photo",
    "svc.accounts", "svc.keyring", "svc.settings", "svc.intent",
    "svc.portal.file", "svc.portal.print", "svc.search", "svc.notify",
    "svc.backup", "svc.audit", "svc.clipboard", "svc.undo-trash", "svc.a11y",
    "svc.model", "ai.local",
    "bg.run"
  ],
  "helpers": [
    {"name": "vcard", "language": "c++23", "capabilities": []},
    {"name": "dav", "language": "c++23", "capabilities": []},
    {"name": "photo", "language": "c++23", "capabilities": []}
  ],
  "mime": {
    "view": ["text/vcard"],
    "edit": ["text/vcard"],
    "import": ["text/vcard", "text/x-vcard", "text/csv", "text/x-ldif", "application/vcard+json", "application/vcard+xml"],
    "export": ["text/vcard", "text/csv", "text/x-ldif", "application/vcard+json"]
  },
  "intents": {
    "handles": ["open", "view", "new", "pick", "share"],
    "emits": ["compose", "open", "share", "print", "scan", "pick"]
  },
  "url_schemes": [],
  "services_provided": [
    "org.pbsd.contacts.picker", "org.pbsd.contacts.complete", "org.pbsd.contacts.lookup",
    "org.pbsd.contacts.dates", "org.pbsd.contacts.keys", "org.pbsd.contacts.trust",
    "org.pbsd.contacts.history"
  ],
  "background": {"autostart": false, "run": true},
  "depends_on": ["org.pbsd.platform >= 0.1", "org.pbsd.passwords >= 0.1"],
  "backing_repos": ["FUSE", "FORGE"],
  "priority": "P1"
}
